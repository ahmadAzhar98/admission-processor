# Copy to .env for local runs. Development values only; deployments read
# secrets from OpenFaaS secrets (see infra/README.md).
AP_ENVIRONMENT=dev
AP_DATABASE_URL=postgresql://admission:admission@localhost:5432/admission
AP_S3_ENDPOINT=http://localhost:8333
AP_S3_BUCKET=admission-documents
AP_S3_ACCESS_KEY=admission
AP_S3_SECRET_KEY=admission-secret
AP_OLLAMA_URL=http://localhost:11434
AP_LLM_MODEL=qwen2.5:7b-instruct
AP_EMBEDDING_MODEL=nomic-embed-text
AP_OCR_ENGINE=paddle+tesseract
# Tenant API key hashes for local testing: sha256 of the key, e.g.
#   python -c "from common.auth import hash_api_key; print(hash_api_key('dev-key-a'))"
AP_SECRET_UNI_A_API_KEY=
AP_SECRET_UNI_A_STAFF_KEY=
