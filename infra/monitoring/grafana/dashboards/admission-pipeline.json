{
  "uid": "admission-pipeline",
  "title": "Admission pipeline",
  "tags": [
    "admission",
    "openfaas"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "function",
        "type": "query",
        "includeAll": true,
        "multi": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gateway_function_invocation_total, function_name)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Invocations per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (function_name) (rate(gateway_function_invocation_total{function_name=~\"$function\"}[1m]))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (function_name) (gateway_service_count{function_name=~\"$function\"})",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, function_name) (rate(gateway_functions_seconds_bucket{function_name=~\"$function\"}[5m])))",
          "legendFormat": "p50 {{function_name}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, function_name) (rate(gateway_functions_seconds_bucket{function_name=~\"$function\"}[5m])))",
          "legendFormat": "p95 {{function_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue depth (pending events)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumer_name) (jetstream_consumer_num_pending)",
          "legendFormat": "{{consumer_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate (5xx share)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (function_name) (rate(gateway_function_invocation_total{function_name=~\"$function\",code=~\"5..\"}[5m])) / sum by (function_name) (rate(gateway_function_invocation_total{function_name=~\"$function\"}[5m]))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Invocations by status code",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (increase(gateway_function_invocation_total{function_name=~\"$function\"}[$__range]))",
          "legendFormat": "{{code}}"
        }
      ]
    }
  ]
}
